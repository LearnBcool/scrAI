APP_NAME=scrapAI
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL (psycopg 3)
DATABASE_URL=postgresql://user:password@localhost:5432/scrapai

# CORS: comma-separated origins
CORS_ORIGINS=http://localhost:5173

# LLM provider (OpenAI-compatible via LiteLLM)
# Primario: Google Gemini free tier (validado em 08/2026)
LLM_MODEL=openai/gemini-3.7-flash
LLM_API_KEY=
LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# Fallback: Groq free tier (descomente para ativar)
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_API_KEY=
# LLM_API_BASE=

# Search provider: duckduckgo (default) | tavily | serpapi
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Vector memory (optional RAG)
VECTOR_DB_ENABLED=false
CHROMA_DIR=./data/chroma

# Crawling
CRAWL_MAX_PAGES=20
CRAWL_CONCURRENCY=2
